@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Заявки — панель администратора КАДР</title>
    <link rel="stylesheet" href="~/booking.css" />
    <script src="~/js/admin-bookings.js" defer></script>
</head>
<body>
    <header>
        <a class="brand" href="/">КАДР</a>
        <form method="post" action="/admin/logout">
            @Html.AntiForgeryToken()
            <button type="submit">Выйти</button>
        </form>
    </header>
    <main>
        <section class="intro">
            <p class="eyebrow">ПАНЕЛЬ АДМИНИСТРАТОРА</p>
            <h1>Заявки</h1>
            <p>Данные загружаются с сервера. Удаление заявки нельзя отменить.</p>
        </section>
        <section class="requests" aria-label="Список заявок">
            <div id="adminRequests" aria-live="polite">Загрузка заявок…</div>
            <p id="adminNotice" role="status"></p>
        </section>
    </main>
    <form id="antiforgeryForm" hidden>@Html.AntiForgeryToken()</form>
</body>
</html>
